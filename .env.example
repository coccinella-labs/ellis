# AI completion providers. At least one must be configured for production.
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
# OpenRouter requires an API key even for its free models.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# AtlasCloud is optional and must be selected explicitly.
# Get one at https://www.atlascloud.ai/
ATLASCLOUD_API_KEY=
# Disable Gemini even if GEMINI_API_KEY is set (useful for local testing).
DISABLE_GEMINI=false
# Database (Neon). Required for drizzle migrations and session storage.
DATABASE_URL=
# Upstash Redis rate limiting for the serverless /api/complete handler.
# Both values are required to activate the Redis store; otherwise the
# handler falls back to an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server
PORT=3000